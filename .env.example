# Copiar este archivo como .env y completar con los valores del proyecto.
# Se obtienen en el dashboard de Supabase: Settings > API
#
# Estas dos variables tambien hay que cargarlas en Vercel
# (Project Settings > Environment Variables), porque .env no se sube al repo.
#
# Solo la clave anon: es publica por diseno y el acceso real lo controlan
# las politicas RLS. La clave service_role nunca va en el frontend.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
